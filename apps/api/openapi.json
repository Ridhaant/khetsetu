    "/orders/{id}/transition": {
      "post": {
        "summary": "Advance an authorised order state; verified storage proof required for delivery",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "accepted",
                      "packed",
                      "dispatched",
                      "delivered",
                      "completed",
                      "cancelled"
                    ]
                  },
                  "proof": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "photo"
                      },
                      "reference": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "reference"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
