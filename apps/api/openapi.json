  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ServiceabilityResult": {
        "type": "object",
        "properties": {
          "pin": {
            "type": "string"
          },
          "serviceable": {
            "type": "boolean",
            "description": "Development checkout eligibility only; not a real logistics promise."
          },
          "scope": {
            "enum": [
              "national",
              "pilot"
            ]
          },
          "validation": {
            "const": "format-only"
          },
          "logisticsVerified": {
            "const": false
          },
          "reason": {
            "enum": [
              "invalid_pin",
              "explicitly_denied",
              "outside_pilot",
              "eligible_development"
            ]
          },
          "deliveryChargePaise": {
            "type": "integer",
            "description": "Illustrative development fee, not a carrier quote."
          },
          "freeDeliveryAbovePaise": {
            "type": "integer"
          },
          "pickupAvailable": {
            "type": "boolean",
            "description": "Development workflow eligibility; actual pickup is unverified."
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "pin",
          "serviceable",
          "scope",
          "validation",
          "logisticsVerified",
          "reason",
