{
  "openapi": "3.1.0",
  "info": {
    "title": "KhetSetu Development API",
    "version": "0.2.0",
    "description": "Development reference only. Volatile data; demo-role authentication. Production startup disabled. INR prices in catalog; all order/payment monetary fields integer paise. UTC timestamps. Default national scope accepts six-digit PIN syntax starting with 1–9, subject to explicit denials. This does not verify postal existence, seller coverage, pickup, or carrier delivery. Configurable pilot/allow/deny policies apply consistently to serviceability, checkout, RFQs, and quote acceptance. Persistent PostgreSQL checkout still requires an explicitly active service area."
  },
  "servers": [
    {
      "url": "http://localhost:4000/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/catalog": {
      "get": {
        "summary": "Browse active, nonexpired sample listings",
        "security": [],
        "parameters": [
          {
            "name": "pin",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{5}$"
            },
            "description": "Serviceability must still be checked at checkout."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Listing"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/sellers": {
      "get": {
        "summary": "Browse seeded verified seller fixtures",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
