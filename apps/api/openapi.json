                }
              }
            }
          }
        }
      }
    },
    "/auth/demo": {
      "post": {
        "summary": "Create an explicit development role session; unavailable in production",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "buyer",
                      "seller",
                      "admin"
                    ]
                  },
                  "sellerId": {
                    "enum": [
                      "s1",
                      "s2",
                      "s3"
                    ]
                  }
                },
                "required": [
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "const": 900
                    },
                    "user": {
                      "$ref": "#/components/schemas/Actor"
                    },
                    "demo": {
                      "const": true
                    }
                  },
                  "required": [
                    "accessToken",
                    "expiresIn",
                    "user",
                    "demo"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/otp/request": {
      "post": {
        "summary": "Returns 503 until SMS OTP adapter is integrated",
