    "/payments/webhook": {
      "post": {
        "summary": "Razorpay exact-raw-body HMAC-SHA256 verification and event deduplication",
        "security": [],
        "parameters": [
          {
            "name": "x-razorpay-signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
