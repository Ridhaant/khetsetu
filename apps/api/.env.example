PORT=4000
NODE_ENV=development
DEMO_MODE=true
# Development marketplace scope only: national accepts PIN syntax, without verifying delivery.
SERVICEABILITY_MODE=national
# Optional pilot restriction. An explicit deny always wins over national/allow/pilot settings.
SERVICEABILITY_PILOT_PINS=400008
SERVICEABILITY_ALLOW_PINS=
SERVICEABILITY_DENY_PINS=
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://khetsetu:local_only_password@localhost:5432/khetsetu?schema=public
# Required in production, at least 32 bytes. Never use demo keys in production.
ACCESS_TOKEN_SECRET=
# Only rzp_test_ keys are accepted. Live keys are rejected by this demo API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMS_PROVIDER=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=khetsetu-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
REDIS_URL=redis://localhost:6379
